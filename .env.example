# Required for receipt scanning (server-side only, never exposed to the browser).
# Free key, free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the vision model used to read receipts.
# GEMINI_MODEL=gemini-3.8-flash


# Required for group cover photos (server-side only, never exposed to the browser).
# Free key: https://unsplash.com/developers -> New Application
UNSPLASH_ACCESS_KEY=
